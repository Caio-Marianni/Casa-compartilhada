# Supabase → Settings → API Keys → aba "Publishable and secret API keys".
# Copie este arquivo para .env e preencha as duas linhas.
#
# A publishable key (sb_publishable_...) é pública por design: a RLS é que protege.
# A secret key (sb_secret_...) NUNCA entra aqui — ela ignora RLS, e este arquivo
# vai parar inteiro dentro do navegador de quem abrir o app.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
